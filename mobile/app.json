{
  "expo": {
    "name": "uniFITS Member",
    "slug": "unifits-member",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1E2128"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.unifits.memberapp",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow uniFITS to take a profile photo.",
        "NSPhotoLibraryUsageDescription": "Allow uniFITS to select a profile photo from your library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#1E2128"
      },
      "package": "com.unifits.memberapp",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-image-picker"
    ]
  }
}